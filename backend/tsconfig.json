{
  "compilerOptions": {
    "target": "es2022",
    "module": "Node16",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node16",
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "prisma/**/*", "eslint.config.mjs"],
  "exclude": ["node_modules", "dist"]
}
